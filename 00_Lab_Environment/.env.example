# Image versions for the lab stack, TARGET LINE: Kafka 4.4, Confluent Platform 8.4, Spark 4.3.0.
# STATUS: NOT VALIDATED. Confirm each tag exists and run every lab (S01-S12) on this stack before delivery.
# The verified 3.x/7.x stack is kept in kafka-spark-lab (v7).
# Each tag below is a placeholder that must be confirmed to exist and tested together.
# Rule: Kafka, Schema Registry, Connect and ksqlDB must come from one compatible release line.

KAFKA_IMAGE=apache/kafka:4.4.0
SCHEMA_REGISTRY_IMAGE=confluentinc/cp-schema-registry:8.4.0
CONNECT_IMAGE=confluentinc/cp-kafka-connect:8.4.0
KSQLDB_IMAGE=confluentinc/cp-ksqldb-server:8.4.0
POSTGRES_IMAGE=postgres:16
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2   # pinned: 'latest' is not reproducible; confirm the tag exists at freeze

# KRaft cluster id. Generate once per classroom stack and keep it fixed.
CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Java & PySpark runtime configuration (defaults)
# Set JAVA_HOME in your shell or workstation environment
PYSPARK_PYTHON=.venv/bin/python
PYSPARK_DRIVER_PYTHON=.venv/bin/python
